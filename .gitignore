# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
dist/
# 配置文件：一律不入库（含真实 AK/SK、数据库密码、JWT 密钥）
# 只放行不含任何真实值的样例文件
configs/*.yaml
!configs/config.example.yaml

# 本地 AI 工具配置（含本机绝对路径，不入库）
.claude/settings.local.json

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.html

# Dependency directories
vendor/

# Go workspace file
go.work

# 环境变量文件（包括 .env.production / .env.test 等，禁止提交真实凭据）
.env*

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db

# Build artifacts
/build/
/tmp/
/config.yaml

# CI 的 Go 模块缓存目录（部分 CI 会写在这里）
.gomodcache/
